# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# --- Token360 (https://www.token360.ai/en-US/sign-up?utm_source=github&utm_medium=fork&utm_campaign=ecom-image-skill)
IMAGE_API_BASE=https://api.token360.ai/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_REF_FIELD=images
# Seedream low-cost route: IMAGE_MODEL=seedream-4.5 and
# IMAGE_EXTRA_BODY={"watermark":false}

# --- Official OpenAI (or any OpenAI-compatible endpoint) instead:
# IMAGE_API_BASE=https://api.openai.com
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-flare
